{
    "name": "infrangible/m2-catalog-product-option-select2",
    "description": "Adds the custom option type \"Select2\": a drop-down for product options that is rendered as a styled selection box instead of the plain browser list.",
    "type": "magento2-module",
    "version": "1.2.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Select2 custom options",
        "searchable option drop-down",
        "styled custom option select"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-select2",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-select2": "~1.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionSelect2\\": "src"
        }
    }
}
